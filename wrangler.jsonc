{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saia",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    // rsbuild output; `bun run build` must run before deploy (the deploy script does).
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes like /claims/new fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only API calls wake the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Secrets (not in this file): `wrangler secret put CMC_API_KEY`
  // Local `wrangler dev` reads them from .dev.vars (gitignored).
}
