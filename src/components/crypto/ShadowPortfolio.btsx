import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import SegmentBar from '@/components/kit/SegmentBar.btsx'
import { removeHolding, setHoldingAmount, useHoldings } from '@/lib/crypto/holdings'
import { coinLogo, phpPrice, signedPercent, usd, type Coin } from '@/lib/crypto/market'
import { peso } from '@/lib/insurance/format'

module
  const changeAmount = (id: string, value: string) => {
    const amount = Number(value)
    if (Number.isFinite(amount) && amount >= 0) setHoldingAmount(id, amount)
  }

  const PALETTE = ['var(--chart-1)', 'var(--chart-2)', 'var(--chart-3)', 'var(--chart-4)', 'var(--active)', 'var(--chart-5)']

// Simulated holdings valued at live prices: totals in USD and PHP, allocation, and editable amounts.
props { coins, usdPhp }: { coins: readonly Coin[]; usdPhp: number }
setup
  const holdings = useHoldings()
  const rows = holdings
    .map((holding) => {
      const coin = coins.find((item) => item.id === holding.coinId)
      const value = coin ? holding.amount * coin.priceUsd : 0
      // What the position was worth 24h ago, from the percent change.
      const before = coin ? value / (1 + coin.change24h / 100) : 0
      return { holding, coin, value, before }
    })
    .sort((a, b) => b.value - a.value)
  const total = rows.reduce((sum, row) => sum + row.value, 0)
  const before = rows.reduce((sum, row) => sum + row.before, 0)
  const change = before > 0 ? ((total - before) / before) * 100 : 0
  const unpriced = rows.filter((row) => !row.coin).length

div(className='flex flex-col gap-4')
  div(className='flex flex-wrap items-end justify-between gap-4')
    div
      p(className='eyebrow') Simulated total
      p(className='numeral mt-1.5 text-[36px] font-medium leading-none md:text-[44px]') #{usd(total)}
      p(className='mt-2 font-mono text-sm text-muted-foreground numeral') #{peso(total * usdPhp)}
    if total > 0
      div(className='text-right')
        p(className='eyebrow') 24h
        p(className={cn('mt-1.5 font-mono text-lg numeral', change >= 0 ? 'text-success-foreground' : 'text-destructive-foreground')}) #{signedPercent(change)}
        p(className='font-mono text-xs text-muted-foreground numeral') #{`${total - before >= 0 ? '+' : '−'}${usd(Math.abs(total - before))}`}
  if total > 0
    SegmentBar(segments={rows.filter((row) => row.value > 0).map((row, index) => ({ key: row.holding.id, value: row.value, color: PALETTE[index % PALETTE.length] }))})
  div(className='flex flex-col')
    each row, index in rows key row.holding.id
      div(className='flex items-center gap-3 border-t border-border py-2.5')
        span(className='size-2 shrink-0 rounded-full' style={{ background: PALETTE[index % PALETTE.length] }})
        img(src={coinLogo(row.holding.coinId)} alt='' width={24} height={24} loading='lazy' className='size-6 shrink-0 rounded-full')
        div(className='min-w-0 flex-1')
          p(className='truncate text-[14px]') #{row.holding.name}
          p(className='truncate font-mono text-[11px] text-muted-foreground') #{row.coin ? `${phpPrice(row.coin.priceUsd * usdPhp)} · ${total > 0 ? ((row.value / total) * 100).toFixed(1) : '0'}%` : 'No live price'}
        label(className='flex items-center gap-1.5')
          span(className='sr-only') #{`${row.holding.symbol} amount`}
          input(
            ~ type='number'
            ~ min='0'
            ~ step='any'
            ~ value={row.holding.amount}
            ~ onChange={(event) => changeAmount(row.holding.id, event.currentTarget.value)}
            ~ className='h-8 w-24 rounded-md border border-input bg-transparent px-2 text-right font-mono text-[13px] numeral outline-none focus:border-ring'
            ~ )
          span(className='w-11 font-mono text-[11px] text-muted-foreground') #{row.holding.symbol}
        div(className='hidden w-28 text-right sm:block')
          p(className='font-mono text-[13px] numeral') #{row.coin ? usd(row.value) : '—'}
          p(className='font-mono text-[11px] text-muted-foreground numeral') #{row.coin ? peso(row.value * usdPhp) : ''}
        button(type='button' onClick={() => removeHolding(row.holding.id)} aria-label={`Remove ${row.holding.symbol}`} title='Remove' className='grid size-8 shrink-0 place-items-center rounded-full text-muted-foreground hover:bg-surface hover:text-destructive-foreground')
          Icon(name='trash' size={14} className='m-0')
    empty
      p(className='border-t border-border py-8 text-center text-sm text-muted-foreground') Add coins and amounts to see what they’d be worth right now.
  if unpriced > 0
    p(className='text-xs text-muted-foreground') #{`${unpriced} asset${unpriced === 1 ? ' has' : 's have'} left the top 100 and ${unpriced === 1 ? 'is' : 'are'} not priced.`}
  p(className='flex items-center gap-1.5 text-xs text-muted-foreground')
    Icon(name='info' size={13} className='m-0 shrink-0')
    | A simulation only: amounts are what you type here, not balances read from any wallet.
