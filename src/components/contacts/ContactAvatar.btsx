import { cn } from '@/lib/utils'

module
  const initials = (name: string) => name.trim().split(/\s+/).slice(0, 2).map((part) => part[0]?.toUpperCase() ?? '').join('') || '?'

  /** A stable hue per name so the same person keeps the same colour. */
  const hue = (name: string) => [...name].reduce((sum, char) => (sum * 31 + char.charCodeAt(0)) % 360, 7)

props { name, size = 'md', className }: { name: string; size?: 'md' | 'lg'; className?: string }

span(
  ~ aria-hidden={true}
  ~ style={{ background: `oklch(0.72 0.1 ${hue(name)} / 22%)`, color: `oklch(0.6 0.13 ${hue(name)})` }}
  ~ className={cn('grid shrink-0 place-items-center rounded-full font-medium', size === 'lg' ? 'size-14 text-lg' : 'size-9 text-[13px]', className)}
  ~ )
  | #{initials(name)}
