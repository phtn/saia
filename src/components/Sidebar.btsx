import { cn } from "@/lib/utils"
import {Icon, type IconName} from "@/lib/icons"
import { navGroups } from "@/lib/navs"
import { Link } from "@octanejs/tanstack-router"
import { createElement } from "octane"
import FluidTooltip, { FluidTooltipContent, FluidTooltipRoot, FluidTooltipTrigger } from "@/components/ui/FluidTooltip.btsx"

module
  export interface SidebarProps {
  }

  export interface SidebarItemProps {
    href: string
    icon: IconName
    label: string
    value: string | number
    path?: string
    isCompact?: boolean
    // onNavigate: (to: string) => (event: MouseEvent) => void
  }

  const SIDEBAR_CLASS = "hidden md:flex flex-col w-full h-[calc(100dvh-var(--topbar-height))] overflow-hidden"
  const SIDEBAR_ITEM_CLASS = "flex w-full items-center gap-1.75 rounded-[12px] border py-1 pl-1 pr-[8px] text-left transition"
  const SIDEBAR_ITEM_SELECTED_CLASS = "bg-card border-border shadow-[0_1px_2px_oklch(0_0_0/6%)]"
  const SIDEBAR_ITEM_DEFAULT_CLASS = "border-transparent bg-transparent hover:bg-card/60"
  const SIDEBAR_ICON_CONTAINER_CLASS = "flex size-7.5 shrink-0 items-center justify-center rounded-[8px] bg-transparent"
  const SIDEBAR_ICON_SELECTED_CONTAINER_CLASS = "flex size-7.5 shrink-0 items-center justify-center rounded-[8px] bg-surface"
  const SIDEBAR_ICON_CLASS = "m-0 text-muted-foreground/80"
  const SIDEBAR_LABEL_CLASS = "flex-1 font-sans font-medium text-muted-foreground text-sm md:text-[14px] leading-5 tracking-[-0.28px] truncate"
  const SIDEBAR_VALUE_CLASS = "ml-auto shrink-0 text-right font-mono text-2xs leading-none tabular-nums text-muted-foreground"
  const SIDEBAR_SELECTED_TEXT_CLASS = "text-foreground"
  const SIDEBAR_ITEM_COMPACT_CLASS = "justify-center gap-0 p-1"

  export { SidebarNav }

component SidebarItem
  props { href, icon, label, path, isCompact = false }: SidebarItemProps
  setup
    const isExternal = href.startsWith("http")
    const isSelected = href === "/" ? path === "/" : path === href || path?.startsWith(`${href}/`) === true
    const itemClassName = cn(SIDEBAR_ITEM_CLASS, isSelected ? SIDEBAR_ITEM_SELECTED_CLASS : SIDEBAR_ITEM_DEFAULT_CLASS, isCompact && SIDEBAR_ITEM_COMPACT_CLASS)
    const labelClassName = cn(SIDEBAR_LABEL_CLASS, isSelected && SIDEBAR_SELECTED_TEXT_CLASS)
    const iconClassName = cn(SIDEBAR_ICON_CLASS, isSelected && SIDEBAR_SELECTED_TEXT_CLASS)
    const iconContainerClassName = isSelected ? SIDEBAR_ICON_SELECTED_CONTAINER_CLASS : SIDEBAR_ICON_CONTAINER_CLASS
    const compactLink = isCompact
      ? isExternal
        ? createElement("a", { href, className: itemClassName, target: "_blank", rel: "noopener noreferrer" })
        : createElement(Link, { to: href, className: itemClassName, "aria-current": isSelected ? "page" : undefined })
      : undefined

  if isCompact
    FluidTooltipRoot(id={href} side="right" sideOffset={12})
      FluidTooltipTrigger(render={compactLink})
        fragment
          div(className={iconContainerClassName})
            Icon(name={icon} size={18} className={iconClassName})
          span(className="sr-only") #{label}
      FluidTooltipContent #{label}
  else
    if isExternal
      a(href={href} className={itemClassName} target="_blank" rel="noopener noreferrer")
        div(className={iconContainerClassName})
          Icon(name={icon} size={18} className={SIDEBAR_ICON_CLASS})
        span(className={SIDEBAR_LABEL_CLASS}) #{label}
    else
      Link(to={href} className={itemClassName} aria-current={isSelected ? "page" : undefined})
        div(className={iconContainerClassName})
          Icon(name={icon} size={18} className={iconClassName})
        span(className={labelClassName}) #{label}


component SidebarNav
  props { path, className, isCompact = false }: { path: string; className?: string; isCompact?: boolean }
  div(className={cn("p-3 space-y-6", className)})
    each group in navGroups
      div(key={group.title})
        if isCompact
          div(className="mx-2 mb-2 h-0 bg-border/60" role="presentation")
        else
          div(className="eyebrow px-2 mb-2") #{group.title}
        nav(className="space-y-1" aria-label={group.title})
          each item in group.items key item.href
            SidebarItem({...item} path={path} isCompact={isCompact})

component SidebarNavTooltips
  props { path, className, isCompact = false }: { path: string; className?: string; isCompact?: boolean }
  if isCompact
    FluidTooltip(orientation="vertical")
      SidebarNav(path={path} className={className} isCompact)
  else
    SidebarNav(path={path} className={className})

props { path, isCompact = false }: { path: string; isCompact?: boolean }
aside(className={SIDEBAR_CLASS} data-compact={isCompact || undefined})
  SidebarNavTooltips(path={path} isCompact={isCompact} className="flex-1 overflow-scroll")

  div(className="shrink-0 border-t border-border px-4 py-3")
    div(className={cn("mono-caps flex items-center gap-2 text-[10.5px] text-muted-foreground", isCompact && "justify-center")})
      span(className="size-1.5 rounded-full bg-success pulse-dot")
      if !isCompact
        span
          span(className="text-success") Live
          | #{' · local book'}
