import { cn } from '@/lib/utils'

module
  export interface SegmentOption {
    value: string
    label: string
    count?: number
  }

  export interface SegmentedProps {
    options: readonly SegmentOption[]
    value: string
    onChange: (value: string) => void
    label: string
    className?: string
  }

// Pill tabs with counts; the active segment is raised like a key.
props { options, value, onChange, label, className }: SegmentedProps

div(role='tablist' aria-label={label} className={cn('flex w-full gap-1 overflow-x-auto rounded-full border border-border bg-shell p-1', className)})
  each option in options key option.value
    button(
      ~ type='button'
      ~ role='tab'
      ~ aria-selected={option.value === value}
      ~ onClick={() => onChange(option.value)}
      ~ className={cn('flex flex-1 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-full px-3 py-2 text-sm sm:px-4 transition-all duration-200', option.value === value ? 'bg-card text-foreground shadow-[0_1px_2px_oklch(0_0_0/8%),0_4px_12px_-6px_oklch(0_0_0/18%)] ring-1 ring-border' : 'text-muted-foreground hover:text-foreground')}
      ~ )
      span #{option.label}
      if option.count !== undefined
        span(className='rounded-md bg-surface px-1.5 py-0.5 font-mono text-[11px] leading-none text-muted-foreground numeral') #{option.count}
