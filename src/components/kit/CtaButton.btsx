import { cn } from '@/lib/utils'
import { Icon, type IconName } from '@/lib/icons'

module
  /**
   * Colour follows intent so actions can't be mistaken for one another:
   * accent = quotes/policies, claim = claims, solid = commit a form,
   * outline/ghost = neutral utilities, danger = destructive.
   */
  export type CtaVariant = 'accent' | 'claim' | 'solid' | 'outline' | 'ghost' | 'danger'

  export interface CtaButtonProps {
    label: string
    icon?: IconName
    variant?: CtaVariant
    size?: 'sm' | 'md' | 'lg'
    type?: 'button' | 'submit'
    disabled?: boolean
    pending?: boolean
    onClick?: () => void
    className?: string
    'aria-label'?: string
  }

  const VARIANTS: Record<CtaVariant, string> = {
    accent: 'bg-accent-brand text-accent-brand-foreground shadow-[var(--shadow-cta)] hover:brightness-105',
    claim: 'bg-claim text-claim-foreground shadow-[var(--shadow-cta-claim)] hover:brightness-105',
    solid: 'bg-invert text-invert-foreground shadow-[0_8px_20px_-10px_oklch(0_0_0/50%)] hover:brightness-110',
    outline: 'border border-border bg-card text-foreground hover:bg-surface',
    ghost: 'text-muted-foreground hover:bg-surface hover:text-foreground',
    danger: 'border border-destructive/40 text-destructive-foreground hover:bg-destructive/10'
  }

  const SIZES = { sm: 'h-8 px-3 text-[13px] gap-1.5', md: 'h-10 px-4 text-sm gap-2', lg: 'h-[52px] px-6 text-[15px] gap-2' } as const

// Pill buttons: orange glow for quotes, teal for claims, black slab to commit, red outline to destroy.
props { label, icon, variant = 'outline', size = 'md', type = 'button', disabled = false, pending = false, onClick, className, 'aria-label': ariaLabel }: CtaButtonProps

button(
  ~ type={type}
  ~ disabled={disabled || pending}
  ~ aria-busy={pending || undefined}
  ~ aria-label={ariaLabel}
  ~ onClick={onClick}
  ~ className={cn('inline-flex shrink-0 cursor-pointer items-center justify-center whitespace-nowrap rounded-full font-medium transition-all duration-200 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background', VARIANTS[variant], SIZES[size], className)}
  ~ )
  if pending
    Icon(name='spinner-ring' size={16} className='m-0')
  elseif icon
    Icon(name={icon} size={16} className='m-0')
  span #{label}
