import type { OctaneNode } from 'octane'
import { cn } from '@/lib/utils'
import { Icon, type IconName } from '@/lib/icons'

module
  export interface ShellProps {
    title?: string
    icon?: IconName
    /** Right side of the header: filters, close buttons. */
    actions?: OctaneNode
    /** Footer strip under the panels: overflow menu, caption, secondary action. */
    footer?: OctaneNode
    className?: string
    children?: OctaneNode
  }

// The outer, layered card from the reference designs: a soft shell holding one or more panels.
props { title, icon, actions, footer, className, children }: ShellProps

section(className={cn('shell flex flex-col gap-1.5', className)})
  if title || actions
    header(className='flex items-center justify-between gap-3 px-4 pt-3 pb-2 ')
      div(className='flex min-w-0 items-center gap-2')
        if icon
          Icon(name={icon} size={16} className='m-0 text-muted-foreground')
        h2(className='truncate text-[15px] font-medium tracking-tight') #{title}
      div(className='flex shrink-0 items-center gap-2') #{actions}
  | #{children}
  if footer
    footer(className='flex items-center justify-between gap-3 px-3 pt-1 pb-1.5') #{footer}
