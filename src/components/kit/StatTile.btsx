import { cn } from '@/lib/utils'
import { TONE_CLASSES, type Tone } from '@/lib/insurance/status'

module
  export interface StatTileProps {
    label: string
    value: string | number
    unit?: string
    caption?: string
    captionTone?: Tone
    className?: string
  }

props { label, value, unit, caption, captionTone = 'neutral', className }: StatTileProps

div(className={cn('tile flex min-w-0 flex-col gap-1.5 px-3.5 py-3', className)})
  span(className='eyebrow truncate') #{label}
  div(className='flex items-baseline gap-1')
    span(className='numeral truncate text-[22px] font-medium leading-none') #{value}
    if unit
      span(className='text-xs text-muted-foreground') #{unit}
  if caption
    span(className={cn('mono-caps truncate text-[10.5px]', TONE_CLASSES[captionTone].text)}) #{caption}
