import { cn } from '@/lib/utils'

module
  export interface RingGaugeProps {
    /** 0 to 1. */
    value: number
    label: string
    size?: number
    stroke?: number
    /** CSS colour for the arc; defaults to the success token. */
    color?: string
    className?: string
  }

// The circular score from the references: a track, an arc, and a centred label.
props { value, label, size = 96, stroke = 7, color = 'var(--success)', className }: RingGaugeProps
setup
  const clamped = Math.max(0, Math.min(1, value))
  const radius = (size - stroke) / 2
  const circumference = 2 * Math.PI * radius
  const dash = `${circumference * clamped} ${circumference}`

div(className={cn('relative shrink-0', className)} style={{ width: `${size}px`, height: `${size}px` }})
  svg(width={size} height={size} viewBox={`0 0 ${size} ${size}`} className='-rotate-90' aria-hidden={true})
    circle(cx={size / 2} cy={size / 2} r={radius} fill='none' stroke='var(--surface-2)' strokeWidth={stroke})
    circle(cx={size / 2} cy={size / 2} r={radius} fill='none' stroke={color} strokeWidth={stroke} strokeLinecap='round' strokeDasharray={dash} style={{ transition: 'stroke-dasharray 600ms cubic-bezier(0.22, 1, 0.36, 1)' }})
  span(className='absolute inset-0 grid place-items-center text-[22px] font-medium numeral') #{label}
