import type { OctaneNode } from 'octane'
import { cn } from '@/lib/utils'
import { Icon, type IconName } from '@/lib/icons'
import { TONE_CLASSES, type Tone } from '@/lib/insurance/status'

module
  export interface MetaPart {
    text: string
    tone?: Tone
  }

  export interface ListRowProps {
    icon: IconName
    title: string
    meta?: readonly (string | MetaPart)[]
    /** A small status dot on the icon badge. */
    badgeTone?: Tone
    trailing?: OctaneNode
    onClick?: () => void
    className?: string
  }

  const part = (item: string | MetaPart): MetaPart => (typeof item === 'string' ? { text: item } : item)

component RowBody
  props { icon, title, meta = [], badgeTone }: Pick<ListRowProps, 'icon' | 'title' | 'meta' | 'badgeTone'>
  div(className='relative grid size-10 shrink-0 place-items-center rounded-full border border-border bg-card')
    Icon(name={icon} size={17} className='m-0 text-muted-foreground')
    if badgeTone
      span(className={cn('absolute -right-0.5 -top-0.5 size-2.5 rounded-full ring-2 ring-card', TONE_CLASSES[badgeTone].dot)})
  div(className='min-w-0 flex-1')
    p(className='truncate text-[15px] leading-6') #{title}
    div(className='mono-caps flex min-w-0 flex-wrap items-center gap-x-1.5 text-[10.5px] text-muted-foreground')
      each item, index in meta.map(part) key `${index}-${item.text}`
        fragment
          if index > 0
            span(aria-hidden={true}) ·
          span(className={cn('truncate', item.tone && TONE_CLASSES[item.tone].text)}) #{item.text}

props { icon, title, meta = [], badgeTone, trailing, onClick, className }: ListRowProps
setup const rowClass = cn('flex w-full items-center gap-3.5 p-3 text-left', onClick && 'cursor-pointer transition-colors hover:bg-surface/70', className)

if onClick
  button(type='button' className={rowClass} onClick={onClick})
    RowBody(icon={icon} title={title} meta={meta} badgeTone={badgeTone})
    | #{trailing}
else
  div(className={rowClass})
    RowBody(icon={icon} title={title} meta={meta} badgeTone={badgeTone})
    | #{trailing}
