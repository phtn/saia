import { cn } from '@/lib/utils'

module
  export interface BarSegment {
    key: string
    value: number
    color: string
  }

// A distribution bar split into rounded segments, sized by value.
props { segments, className }: { segments: readonly BarSegment[]; className?: string }
setup
  const total = segments.reduce((sum, segment) => sum + segment.value, 0)

div(className={cn('flex h-1.5 w-full gap-1', className)} role='presentation')
  if total === 0
    div(className='h-full flex-1 rounded-full bg-surface-2')
  else
    each segment in segments.filter((item) => item.value > 0) key segment.key
      div(className='h-full rounded-full transition-[flex-grow] duration-500' style={{ flexGrow: segment.value, background: segment.color }})
