import { cn } from '@/lib/utils'

module
  export interface BarDatum {
    label: string
    value: number
    /** Formatted value for the tooltip and the highlighted label. */
    display: string
  }

  export interface BarChartProps {
    data: readonly BarDatum[]
    /** Accessible summary of what the bars show. */
    label: string
    height?: number
    className?: string
  }

// Single-series column chart: one hue, 4px rounded tops on the baseline, the
// largest bar labelled, every bar's value on hover/focus.
props { data, label, height = 180, className }: BarChartProps
setup
  const max = Math.max(1, ...data.map((item) => item.value))
  const peak = data.reduce((best, item, index) => (item.value > (data[best]?.value ?? -1) ? index : best), 0)

figure(className={cn('flex flex-col gap-2', className)} aria-label={label})
  div(className='relative flex items-end gap-[2px] border-b border-border' style={{ height: `${height}px` }})
    each item, index in data key item.label
      div(tabIndex={0} className='group relative flex h-full min-w-0 flex-1 items-end outline-none' aria-label={`${item.label}: ${item.display}`})
        div(className='w-full rounded-t-[4px] bg-accent-brand/85 transition-colors group-hover:bg-accent-brand group-focus-visible:bg-accent-brand' style={{ height: `${Math.max(2, (item.value / max) * (height - 22))}px` }})
        span(className={cn('pointer-events-none absolute left-1/2 z-10 -translate-x-1/2 whitespace-nowrap rounded-md bg-invert px-1.5 py-0.5 font-mono text-[10.5px] text-invert-foreground numeral transition-opacity', index === peak ? 'opacity-100' : 'opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100')} style={{ bottom: `${Math.max(2, (item.value / max) * (height - 22)) + 4}px` }}) #{item.display}
  div(className='flex gap-[2px]')
    each item in data key item.label
      span(className='min-w-0 flex-1 truncate text-center font-mono text-[10px] text-muted-foreground') #{item.label}
