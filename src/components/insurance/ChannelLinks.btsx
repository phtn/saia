import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import { MESSAGE_CHANNELS, channelLink, type ContactHandles } from '@/lib/insurance/messages'

module
  export interface ChannelLinksProps {
    contact: ContactHandles
    message: string
    compact?: boolean
  }

// Deep links that open the client's messaging app with the message filled in.
props { contact, message, compact = false }: ChannelLinksProps
setup
  const links = MESSAGE_CHANNELS.map((channel) => ({ channel, href: channelLink(channel, contact, message) })).filter((link): link is { channel: typeof link.channel; href: string } => link.href !== null)

div(className='flex flex-wrap gap-1.5')
  each link in links key link.channel
    a(href={link.href} target='_blank' rel='noopener noreferrer' className={cn('inline-flex items-center gap-1.5 rounded-full border border-border bg-card transition-colors hover:bg-surface', compact ? 'px-2.5 py-1 text-xs text-muted-foreground hover:text-foreground' : 'px-3 py-1.5 text-[13px]')})
      if !compact
        Icon(name={link.channel === 'Email' ? 'mail' : link.channel === 'SMS' ? 'phone' : 'message'} size={14} className='m-0 text-muted-foreground')
      | #{link.channel}
  empty
    span(className='text-xs text-muted-foreground') No contact details on file.
