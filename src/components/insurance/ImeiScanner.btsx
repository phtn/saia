import { useEffect, useRef, useState } from 'octane'
import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import CtaButton from '@/components/kit/CtaButton.btsx'
import Chip from '@/components/kit/Chip.btsx'
import { barcodeScanningSupported, detectImeiBarcodes, formatImei, hasImeiOcrProvider, readImeiFromImage, typeAllocationCode, validateImei, type ImeiReading } from '@/lib/insurance/imei'
import { ENTER_CLASS, fieldLabelClassName } from '@/lib/forms/step-flow'

module
  export interface ImeiScannerProps {
    value: string
    onChange: (imei: string) => void
    /** Fires with every reading, including the second IMEI of dual-SIM phones. */
    onReading?: (reading: ImeiReading) => void
    disabled?: boolean
  }

  type Phase = 'idle' | 'camera' | 'reading'

// Reads an IMEI three ways: live barcode scan of the phone box, a photo of the
// box or the *#06# screen, or typing it. Ported from lib/js/imeiScanner.js.
props { value, onChange, onReading, disabled = false }: ImeiScannerProps
setup
  const [phase, setPhase] = useState<Phase>('idle')
  const [error, setError] = useState('')
  const [lastSource, setLastSource] = useState<ImeiReading['source'] | null>(null)
  const [alternates, setAlternates] = useState<string[]>([])
  const videoRef = useRef<HTMLVideoElement | null>(null)
  const streamRef = useRef<MediaStream | null>(null)
  const captureRef = useRef<HTMLInputElement | null>(null)
  const uploadRef = useRef<HTMLInputElement | null>(null)
  const canScanLive = barcodeScanningSupported() && typeof navigator !== 'undefined' && navigator.mediaDevices !== undefined
  const validation = validateImei(value)
  const busy = phase === 'reading'

  const accept = (reading: ImeiReading) => {
    setError('')
    setLastSource(reading.source)
    setAlternates(reading.all.filter((imei) => imei !== reading.imei))
    onChange(reading.imei)
    onReading?.(reading)
  }

  const stopCamera = () => {
    streamRef.current?.getTracks().forEach((track) => track.stop())
    streamRef.current = null
  }

  const startCamera = async () => {
    setError('')
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false })
      streamRef.current = stream
      setPhase('camera')
    } catch {
      setError('Camera unavailable. Take or upload a photo, or type the IMEI.')
    }
  }

  // Attach the stream once the <video> is mounted, then poll frames for barcodes.
  useEffect(() => {
    if (phase !== 'camera') return
    const video = videoRef.current
    const stream = streamRef.current
    if (video === null || stream === null) return
    video.srcObject = stream
    void video.play()
    let cancelled = false
    const tick = async () => {
      if (cancelled) return
      if (video.readyState >= 2) {
        const found = await detectImeiBarcodes(video)
        if (!cancelled && found.length > 0) {
          stopCamera()
          setPhase('idle')
          accept({ imei: found[0], all: found, source: 'barcode' })
          return
        }
      }
      window.setTimeout(() => void tick(), 280)
    }
    void tick()
    return () => {
      cancelled = true
    }
  }, [phase])

  useEffect(() => () => stopCamera(), [])

  const readFile = async (event: Event) => {
    const input = event.currentTarget as HTMLInputElement
    const file = input.files?.[0]
    input.value = ''
    if (!file) return
    setPhase('reading')
    setError('')
    try {
      const reading = await readImeiFromImage(file)
      if (reading) accept(reading)
      else setError(hasImeiOcrProvider() || barcodeScanningSupported() ? 'No IMEI detected. Enter it manually or try another photo.' : 'This browser cannot read barcodes. Type the IMEI from the box or *#06# screen.')
    } catch {
      setError('Scan failed. Please try again or enter the IMEI manually.')
    } finally {
      setPhase('idle')
    }
  }

div(className='flex flex-col gap-3')
  div(className='rounded-xl border border-dashed border-border bg-muted/30 p-3')
    div(className='flex flex-wrap items-center gap-2')
      input(ref={captureRef} type='file' accept='image/*' capture='environment' className='hidden' onChange={readFile})
      input(ref={uploadRef} type='file' accept='image/*' className='hidden' onChange={readFile})
      if canScanLive
        CtaButton(label={phase === 'camera' ? 'Stop camera' : 'Scan box barcode'} icon='scan' size='sm' variant={phase === 'camera' ? 'solid' : 'outline'} disabled={disabled || busy} onClick={() => { if (phase === 'camera') { stopCamera(); setPhase('idle') } else void startCamera() }})
      CtaButton(label='Take photo' icon='camera' size='sm' pending={busy} disabled={disabled || phase === 'camera'} onClick={() => captureRef.current?.click()})
      CtaButton(label='Upload photo' icon='upload' size='sm' variant='ghost' disabled={disabled || busy || phase === 'camera'} onClick={() => uploadRef.current?.click()})
      if lastSource && validation.valid
        span(className='inline-flex items-center gap-1 text-xs text-success')
          Icon(name='check-circle' size={14} className='m-0')
          | #{lastSource === 'barcode' ? 'Read from barcode' : 'IMEI read'}
    if phase === 'camera'
      div(className={cn('relative mt-3 aspect-[4/3] w-full overflow-hidden rounded-lg bg-black sm:aspect-video', ENTER_CLASS)})
        video(ref={videoRef} playsInline muted className='h-full w-full object-cover')
        div(className='pointer-events-none absolute inset-x-[12%] inset-y-[30%] rounded-md border-2 border-white/80')
          div(className='scan-line h-1/2 w-full border-b-2 border-accent-brand/90')
        p(className='absolute inset-x-0 bottom-2 text-center font-mono text-[11px] text-white/85') Point at the IMEI barcode on the box
    p(className='mt-2 text-[11px] text-muted-foreground') Dial *#06# or photograph the IMEI label on the box. Photos are used only to read the IMEI.
  div(className='flex flex-col gap-1.5')
    label(htmlFor='imei-input' className={fieldLabelClassName}) IMEI
    input(
      ~ id='imei-input'
      ~ value={value}
      ~ inputMode='numeric'
      ~ autoComplete='off'
      ~ placeholder='15 digits'
      ~ maxLength={20}
      ~ aria-invalid={value !== '' && !validation.valid ? true : undefined}
      ~ aria-describedby='imei-status'
      ~ onInput={(event) => { setLastSource(null); onChange(event.currentTarget.value.replace(/[^\d\s-]/g, '')) }}
      ~ className='field-input font-mono tracking-wider numeral'
      ~ )
    div(id='imei-status' className='flex min-h-5 flex-wrap items-center gap-2')
      if error
        span(className='inline-flex items-center gap-1 text-xs text-destructive')
          Icon(name='alert' size={13} className='m-0')
          | #{error}
      elseif value === ''
        span(className='text-xs text-muted-foreground') Checked with the Luhn check digit as you type.
      elseif validation.valid
        fragment
          Chip(label='Valid IMEI' tone='success' dot)
          span(className='font-mono text-xs text-muted-foreground') #{`${formatImei(validation.digits)} · TAC ${typeAllocationCode(validation.digits)}`}
      else
        span(className='text-xs text-destructive') #{validation.reason ?? 'Invalid IMEI.'}
    if alternates.length > 0
      div(className='flex flex-wrap items-center gap-2 text-xs text-muted-foreground')
        span Second SIM:
        each imei in alternates key imei
          button(type='button' onClick={() => onChange(imei)} className='rounded-md border border-border px-1.5 py-0.5 font-mono hover:text-foreground') #{formatImei(imei)}
