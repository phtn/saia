import { useNavigate } from '@octanejs/tanstack-router'
import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import { PRODUCT_LIST } from '@/lib/insurance/products'
import type { ProductDefinition, ProductId, QuoteRecord } from '@/lib/insurance/types'

module
  export interface ProductGridProps {
    quotes: readonly QuoteRecord[]
    /** Show the tagline under each product (the full picker) or keep tiles compact. */
    detailed?: boolean
    className?: string
  }

  const OPEN = new Set(['Quote', 'Pending'])

component ProductTile
  props { product, total, open, detailed, onStart }: { product: ProductDefinition; total: number; open: number; detailed: boolean; onStart: (id: ProductId) => void }
  button(type='button' onClick={() => onStart(product.id)} className={cn('tile group flex min-w-0 flex-col gap-2 text-left transition-all duration-200 bg-card hover:bg-surface-2 border border-border shadow-sm active:scale-[0.99]', detailed ? 'p-4' : 'px-3 py-2.5')})
    div(className='flex items-center justify-between gap-2')
      div(className='flex min-w-0 items-center gap-2')
        Icon(name={product.icon} size={detailed ? 18 : 16} className='m-0 shrink-0 text-muted-foreground transition-colors group-hover:text-accent-brand')
        span(className={cn('truncate', detailed ? 'text-[15px]' : 'text-sm')}) #{product.label}
    if detailed
      p(className='meta') #{product.tagline}
    div(className='flex items-center justify-between')
      span(className={cn('mono-caps text-[10px]', open > 0 ? 'text-info' : 'text-muted-foreground')}) #{open > 0 ? `${open} open` : 'Idle'}
      span(className='shrink-0 font-mono text-[11px] text-muted-foreground numeral') ×#{`${total}`}

// The "tools" grid from the references: icon, name, usage count, and a mono status line.
props { quotes, detailed = false, className }: ProductGridProps
setup
  const navigate = useNavigate()
  const counts = (id: ProductId) => {
    const mine = quotes.filter((quote) => quote.product === id)
    return { total: mine.length, open: mine.filter((quote) => OPEN.has(quote.status)).length }
  }
  const start = (id: ProductId) => {
    if (id === 'mobile') navigate({ to: '/mobile' })
    else navigate({ to: '/quote/$product', params: { product: id } })
  }

div(className={cn('grid gap-1.5', detailed ? 'grid-cols-1 sm:grid-cols-3 md:grid-cols-3' : 'md:grid-cols-3 lg:grid-cols-2', className)})
  each product in PRODUCT_LIST key product.id
    ProductTile(product={product} total={counts(product.id).total} open={counts(product.id).open} detailed={detailed} onStart={start})
