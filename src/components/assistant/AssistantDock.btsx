import { useEffect, useMemo, useRef, useState } from 'octane'
import { useNavigate } from '@octanejs/tanstack-router'
import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import Chip from '@/components/kit/Chip.btsx'
import { useTheme } from '@/components/ThemeProvider.btsx'
import { clearTranscript, pushTranscript, setDockOpen, useDock } from '@/lib/assistant/dock'
import { interpret, useAssistantCommands, useAssistantRegistry, type AssistantCommand } from '@/lib/assistant/registry'
import { listen, speak, speechRecognitionSupported, type SpeechSession } from '@/lib/assistant/speech'
import { PRODUCT_LIST, productFromLabel } from '@/lib/insurance/products'
import type { AppPath } from '@/lib/routes'

module
  const PAGES: Record<string, AppPath> = {
    overview: '/', dashboard: '/', home: '/', quote: '/quote', quotes: '/quote', mobile: '/mobile', phone: '/mobile',
    policies: '/policies', policy: '/policies', claims: '/claims', claim: '/claims', analytics: '/analytics', reports: '/analytics', tasks: '/tasks', reminders: '/tasks'
  }

// Voice-ready command surface: typed commands today, speech where the browser supports it.
setup
  const { open, transcript } = useDock()
  const registry = useAssistantRegistry()
  const navigate = useNavigate()
  const { setTheme } = useTheme()
  const [draft, setDraft] = useState('')
  const [partial, setPartial] = useState('')
  const [listening, setListening] = useState(false)
  const session = useRef<SpeechSession | null>(null)
  const inputRef = useRef<HTMLInputElement | null>(null)
  const logRef = useRef<HTMLDivElement | null>(null)
  const canListen = speechRecognitionSupported()

  const commands = useMemo<AssistantCommand[]>(() => [
    {
      id: 'nav.open',
      title: 'Open a page',
      examples: ['Open claims', 'Go to analytics'],
      patterns: [/^(?:open|go to|show|view)\s+(?:the\s+|my\s+)?(?<page>overview|dashboard|home|quotes?|mobile|phone|polic(?:y|ies)|claims?|analytics|reports|tasks|reminders)(?:\s+page)?$/i],
      run: ({ params }) => {
        const to = PAGES[(params.page ?? '').toLowerCase()] ?? '/'
        navigate({ to })
        return `Opening ${params.page}.`
      }
    },
    {
      id: 'quote.new',
      title: 'Start a quote',
      examples: ['New motor quote', 'Quote travel insurance', 'New pet quote'],
      patterns: [/^(?:new|start|create|make)?\s*(?:a\s+)?(?<product>.+?)\s+quote$/i, /^quote\s+(?:a\s+|for\s+)?(?<product>.+)$/i],
      run: ({ params }) => {
        const product = productFromLabel(params.product)
        if (product === null) return `Products: ${PRODUCT_LIST.map((item) => item.label).join(', ')}.`
        if (product === 'mobile') navigate({ to: '/mobile' })
        else navigate({ to: '/quote/$product', params: { product } })
        return `Starting a ${PRODUCT_LIST.find((item) => item.id === product)?.label ?? product} quote.`
      }
    },
    {
      id: 'imei.scan',
      title: 'Scan an IMEI',
      examples: ['Scan IMEI'],
      patterns: [/^(?:scan|read|check)\s+(?:the\s+|an?\s+)?imei$/i],
      run: () => {
        navigate({ to: '/mobile' })
        return 'Opening the IMEI scanner.'
      }
    },
    {
      id: 'claim.new',
      title: 'File a claim',
      examples: ['File a claim'],
      patterns: [/^(?:file|new|start|report)\s+(?:a\s+)?claim$/i],
      run: () => {
        navigate({ to: '/claims/new' })
        return 'Opening a new claim.'
      }
    },
    {
      id: 'theme.set',
      title: 'Switch theme',
      examples: ['Dark mode'],
      patterns: [/^(?:switch to\s+|use\s+|turn on\s+)?(?<mode>dark|light)\s*(?:mode|theme)?$/i],
      run: ({ params }) => {
        const mode = params.mode?.toLowerCase() === 'dark' ? 'dark' : 'light'
        setTheme(mode)
        return `${mode === 'dark' ? 'Dark' : 'Light'} mode on.`
      }
    }
  ], [navigate, setTheme])
  useAssistantCommands(commands)

  const activeForm = registry.forms[registry.forms.length - 1]
  const suggestions = activeForm
    ? [`Set ${activeForm.fields()[0]?.label.toLowerCase() ?? 'client name'} to Ana Cruz`, 'Next', 'Submit']
    : registry.commands.flatMap((command) => command.examples).slice(0, 6)

  const run = (text: string, spoken = false) => {
    const utterance = text.trim()
    if (utterance === '') return
    pushTranscript('user', utterance)
    const reply = interpret(utterance)
    pushTranscript('assistant', reply.message, reply.ok)
    if (spoken) speak(reply.message)
    setDraft('')
  }

  const toggleListening = () => {
    if (listening) {
      session.current?.stop()
      return
    }
    setPartial('')
    session.current = listen({
      onPartial: setPartial,
      onResult: (text) => {
        setPartial('')
        run(text, true)
      },
      onError: (message) => pushTranscript('assistant', message, false),
      onEnd: () => {
        setListening(false)
        session.current = null
      }
    })
    setListening(session.current !== null)
  }

  useEffect(() => {
    if (open) inputRef.current?.focus()
    else session.current?.stop()
  }, [open])

  useEffect(() => {
    const log = logRef.current
    if (log !== null) log.scrollTop = log.scrollHeight
  }, [transcript.length])

if open
  aside(role='dialog' aria-label='Assistant' className='shell fixed inset-x-3 bottom-3 z-50 flex max-h-[min(640px,calc(100dvh-5rem))] flex-col gap-1.5 md:inset-x-auto md:right-5 md:bottom-5 md:w-[400px]')
    header(className='flex items-center justify-between px-3.5 pt-2.5 pb-1')
      div(className='flex items-center gap-2')
        h2(className='text-[15px] font-medium tracking-tight') Assistant
        if listening
          Chip(label='Listening' tone='success' dot pulse)
        elseif activeForm
          Chip(label={activeForm.title} tone='accent' dot)
        else
          Chip(label='Ready' tone='neutral' dot)
      div(className='flex items-center gap-1')
        button(type='button' onClick={clearTranscript} className='grid size-8 place-items-center rounded-full text-muted-foreground hover:bg-surface hover:text-foreground' aria-label='Clear conversation' title='Clear')
          Icon(name='refresh' size={15} className='m-0')
        button(type='button' onClick={() => setDockOpen(false)} className='grid size-8 place-items-center rounded-full text-muted-foreground hover:bg-surface hover:text-foreground' aria-label='Close assistant')
          Icon(name='x' size={16} className='m-0')
    div(ref={logRef} className='panel flex min-h-40 flex-1 flex-col gap-3 overflow-y-auto p-4' aria-live='polite')
      if transcript.length === 0
        div(className='flex flex-col gap-3')
          p(className='text-sm text-muted-foreground') Ask me to open a page, start a quote, or fill the form on screen.
          div(className='eyebrow') Try
      each entry in transcript key entry.id
        div(className={cn('max-w-[85%] rounded-2xl px-3.5 py-2 text-sm', entry.role === 'user' ? 'self-end bg-invert text-invert-foreground' : entry.ok ? 'self-start bg-surface' : 'self-start bg-destructive/10 text-destructive')}) #{entry.text}
      if partial
        div(className='max-w-[85%] self-end rounded-2xl border border-dashed border-border px-3.5 py-2 text-sm text-muted-foreground') #{partial}
      div(className='mt-auto flex flex-wrap gap-1.5 pt-1')
        each suggestion in suggestions key suggestion
          button(type='button' onClick={() => run(suggestion)} className='rounded-full border border-border bg-card px-2.5 py-1 text-xs text-muted-foreground transition-colors hover:text-foreground') #{suggestion}
    form(className='flex items-center gap-2 px-1.5 pb-1.5 pt-0.5' onSubmit={(event) => { event.preventDefault(); run(draft) }})
      if canListen
        button(type='button' onClick={toggleListening} aria-pressed={listening} aria-label={listening ? 'Stop listening' : 'Speak a command'} className={cn('grid size-10 shrink-0 place-items-center rounded-full transition-colors', listening ? 'bg-accent-brand text-accent-brand-foreground shadow-[var(--shadow-cta)]' : 'border border-border bg-card text-muted-foreground hover:text-foreground')})
          Icon(name={listening ? 'mic-off' : 'mic'} size={17} className='m-0')
      input(ref={inputRef} value={draft} onInput={(event) => setDraft(event.currentTarget.value)} placeholder={canListen ? 'Type or tap the mic…' : 'Type a command…'} aria-label='Command' className='field-input h-10 rounded-full')
      button(type='submit' aria-label='Send' disabled={draft.trim() === ''} className='grid size-10 shrink-0 place-items-center rounded-full bg-invert text-invert-foreground transition disabled:opacity-40')
        Icon(name='send' size={16} className='m-0')
