import type { OctaneNode } from 'octane'
import { cn } from '@/lib/utils'

module
  export interface FlowSheetProps {
    title: string
    /** The pill on the right of the title, e.g. "3 / 5 done". */
    badge?: string
    /** Status line and actions under the pipeline. */
    footer?: OctaneNode
    className?: string
    children?: OctaneNode
  }

// The grey sheet with a white pipeline card, as in livesnaps' "Create verification".
props { title, badge, footer, className, children }: FlowSheetProps

div(className={cn('flex flex-col rounded-[26px] border border-border bg-shell shadow-[var(--shadow-shell)]', className)})
  div(className='flex items-center justify-between gap-3 px-5 pt-5 pb-4 md:px-7')
    h2(className='text-xl font-semibold leading-none -tracking-[0.03em] md:text-2xl') #{title}
    if badge
      span(className='inline-flex shrink-0 items-center gap-1.5 rounded-full border border-border bg-muted px-3 py-1 font-mono text-xs text-muted-foreground') #{badge}
  div(className='px-1.5 md:px-3')
    div(className='rounded-2xl bg-card px-3 py-6 shadow-[0_1px_2px_oklch(0_0_0/4%)] md:px-6') #{children}
  if footer
    div(className='flex flex-wrap items-center justify-between gap-3 px-5 py-4 md:px-7') #{footer}
