import FormField from './FormField.btsx'
import type { FlowForm } from '@/lib/forms/useFlowForm'
import type { FieldDef } from '@/lib/insurance/types'

module
  export interface FieldGridProps {
    form: FlowForm
    fields: readonly FieldDef[]
    errors?: Record<string, string>
  }

props { form, fields, errors = {} }: FieldGridProps

div(className='grid grid-cols-1 gap-x-4 gap-y-5 sm:grid-cols-2')
  each field in fields key field.key
    FormField(form={form} field={field} error={errors[field.key]})
