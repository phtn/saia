import type { OctaneNode } from 'octane'
import { Icon, type IconName } from '@/lib/icons'
import { STEP_FLOW_MS, STEP_TILE_CLASS, STEP_TITLE_CLASS, type StepState } from '@/lib/forms/step-flow'
import { cn } from '@/lib/utils'

module
  export interface FlowStepProps {
    icon: IconName
    title: string
    meta?: string
    state: StepState
    /** Position in the pipeline, which staggers the flow downward. */
    index?: number
    /** Total steps, used to stagger a rollback upward. */
    stepCount: number
    isLast?: boolean
    /** Anchor id so the assistant (or a link) can scroll to the step. */
    id?: string
    children?: OctaneNode
  }

// One step of the pipeline: an icon tile on a connecting rail, a title row, and
// the step's own content underneath. Ported from livesnaps' verification-step.btsx.
props { icon, title, meta, state, index = 0, stepCount, isLast = false, id, children }: FlowStepProps

setup
  // The tile lights first, then its rail drains into the next step.
  const tileDelay = `${index * STEP_FLOW_MS}ms`
  const forwardRailDelay = index * STEP_FLOW_MS + STEP_FLOW_MS / 2
  // On rollback, the lowest rail moves first and the delay climbs upward.
  const reverseRailDelay = Math.max(0, stepCount - index - 2) * STEP_FLOW_MS
  const railDelay = `${state === 'done' ? forwardRailDelay : reverseRailDelay}ms`

section(id={id} className='flex scroll-mt-24 gap-3.5' aria-current={state === 'active' ? 'step' : undefined})
  div(className='flex w-8 shrink-0 flex-col items-center')
    span(
      ~ style={{ transitionDelay: tileDelay }}
      ~ className={cn('grid size-8 shrink-0 place-items-center rounded-lg transition-all duration-300 ease-out motion-reduce:transition-none', state === 'active' && 'scale-105', STEP_TILE_CLASS[state])}
      ~ )
      Icon(name={icon} size={17} className='m-0')
    if !isLast
      span(className='relative my-1 w-px flex-1 overflow-hidden bg-border')
        span(
          ~ style={{ transitionDelay: railDelay }}
          ~ className={cn('absolute inset-x-0 top-0 h-full origin-top bg-gradient-to-b from-flow-done/45 to-flow-done transition-transform duration-400 ease-out motion-reduce:transition-none', state === 'done' ? 'scale-y-100' : 'scale-y-0')}
          ~ )
  div(className={cn('min-w-0 flex-1', isLast ? 'pb-1' : 'pb-8')})
    div(className='flex min-h-8 items-center justify-between gap-3')
      h3(
        ~ style={{ transitionDelay: tileDelay }}
        ~ className={cn('text-[17px] font-semibold leading-6 -tracking-[0.02em] transition-colors duration-300 ease-out motion-reduce:transition-none md:text-lg', STEP_TITLE_CLASS[state])}
        ~ )
        | #{title}
      if meta
        span(className='shrink-0 font-mono text-xs text-muted-foreground') #{meta}
    div(className='mt-3') #{children}
