import { useEffect, useRef, useState } from 'octane'
import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import { getClipAudio } from '@/lib/notes/audio-db'
import { clipTime } from '@/lib/notes/recorder'
import type { AudioClip } from '@/lib/notes/types'

module
  export interface ClipPlayerProps {
    clip: AudioClip
    onRemove?: () => void
    className?: string
  }

// One recording: play/pause, scrubbable progress, and its transcript underneath.
props { clip, onRemove, className }: ClipPlayerProps
setup
  const audioRef = useRef<HTMLAudioElement | null>(null)
  const [src, setSrc] = useState('')
  const [missing, setMissing] = useState(false)
  const [playing, setPlaying] = useState(false)
  const [position, setPosition] = useState(0)

  useEffect(() => {
    let url = ''
    let cancelled = false
    getClipAudio(clip.id)
      .then((blob) => {
        if (cancelled) return
        if (!blob) {
          setMissing(true)
          return
        }
        url = URL.createObjectURL(blob)
        setSrc(url)
      })
      .catch(() => setMissing(true))
    return () => {
      cancelled = true
      if (url) URL.revokeObjectURL(url)
    }
  }, [clip.id])

  const toggle = () => {
    const audio = audioRef.current
    if (!audio) return
    if (audio.paused) void audio.play()
    else audio.pause()
  }
  const seek = (event: MouseEvent) => {
    const audio = audioRef.current
    const bar = event.currentTarget as HTMLElement
    if (!audio) return
    const ratio = (event.clientX - bar.getBoundingClientRect().left) / bar.clientWidth
    audio.currentTime = Math.max(0, Math.min(1, ratio)) * clip.duration
    setPosition(audio.currentTime)
  }
  const progress = clip.duration > 0 ? Math.min(100, (position / clip.duration) * 100) : 0

div(data-slot='clip' className={cn('rounded-xl border border-border/70 bg-background/40 p-2.5', className)} onClick={(event) => event.stopPropagation()})
  div(className='flex items-center gap-2.5')
    button(type='button' onClick={toggle} disabled={missing || src === ''} aria-label={playing ? 'Pause recording' : 'Play recording'} className='grid size-8 shrink-0 place-items-center rounded-full bg-invert text-invert-foreground transition hover:brightness-110 disabled:opacity-40')
      Icon(name={playing ? 'pause' : 'play'} size={14} className='m-0')
    div(className='min-w-0 flex-1')
      div(role='slider' aria-label='Seek' aria-valuemin={0} aria-valuemax={Math.round(clip.duration)} aria-valuenow={Math.round(position)} tabIndex={-1} onClick={seek} className='group/bar relative h-5 cursor-pointer')
        div(className='absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 rounded-full bg-foreground/15')
        div(className='absolute left-0 top-1/2 h-1 -translate-y-1/2 rounded-full bg-foreground/70' style={{ width: `${progress}%` }})
      div(className='flex justify-between font-mono text-[10.5px] text-muted-foreground numeral')
        span #{missing ? 'Audio unavailable' : clipTime(position)}
        span #{clipTime(clip.duration)}
    if onRemove
      button(type='button' onClick={onRemove} aria-label='Delete recording' title='Delete recording' className='grid size-7 shrink-0 place-items-center rounded-full text-muted-foreground hover:bg-destructive/10 hover:text-destructive-foreground')
        Icon(name='trash' size={14} className='m-0')
  if clip.transcript
    p(className='mt-2 border-t border-border/60 pt-2 text-[13px] leading-5 text-muted-foreground') #{clip.transcript}
  if src
    audio(
      ~ ref={audioRef}
      ~ src={src}
      ~ preload='metadata'
      ~ onPlay={() => setPlaying(true)}
      ~ onPause={() => setPlaying(false)}
      ~ onEnded={() => { setPlaying(false); setPosition(0) }}
      ~ onTimeUpdate={(event) => setPosition(event.currentTarget.currentTime)}
      ~ )
