import { useEffect, useState, type OctaneNode } from 'octane'
import { cn } from '@/lib/utils'
import { Icon, type IconName } from '@/lib/icons'
import ClipPlayer from './ClipPlayer.btsx'
import { NOTE_COLORS, NOTE_COLOR_KEYS, swatchBackground } from '@/lib/notes/colors'
import { clipTime } from '@/lib/notes/recorder'
import { useNoteCapture, type CaptureMode } from '@/lib/notes/useNoteCapture'
import type { AudioClip, NoteColor, NoteDraft } from '@/lib/notes/types'

module
  export interface NoteFieldsProps extends NoteDraft {
    onChange: (patch: Partial<NoteDraft>) => void
    /** A dictated phrase to append to the body. */
    onAppend: (text: string) => void
    onAddClip: (clip: AudioClip) => void
    onRemoveClip: (clip: AudioClip) => void
    /** Called after any recording in progress has been saved. */
    onDone: () => void
    /** Extra toolbar actions (archive, delete), placed before Close. */
    actions?: OctaneNode
    /** Start dictating or recording as soon as the fields mount. */
    startWith?: 'dictate' | 'record'
    autoFocus?: 'title' | 'body'
  }

  export { ToolButton }

  const LEVEL_BARS = [0.55, 0.8, 1, 0.8, 0.55]

component ToolButton
  props { icon, label, onClick, active = false, tone = 'neutral', disabled = false }: { icon: IconName; label: string; onClick: () => void; active?: boolean; tone?: 'neutral' | 'claim' | 'danger'; disabled?: boolean }
  button(
    ~ type='button'
    ~ onClick={onClick}
    ~ aria-label={label}
    ~ aria-pressed={active}
    ~ title={label}
    ~ disabled={disabled}
    ~ className={cn(
    ~   'grid size-8 shrink-0 place-items-center rounded-full text-foreground/70 transition-colors hover:bg-foreground/10 hover:text-foreground disabled:pointer-events-none disabled:opacity-35',
    ~   active && tone === 'claim' && 'bg-claim text-claim-foreground hover:bg-claim hover:text-claim-foreground',
    ~   active && tone === 'danger' && 'bg-destructive text-white hover:bg-destructive hover:text-white',
    ~   active && tone === 'neutral' && 'bg-foreground/10 text-foreground'
    ~ )}
    ~ )
    Icon(name={icon} size={16} className='m-0')

component CaptureStatus
  props { mode, elapsed, level, partial, onStop }: { mode: CaptureMode; elapsed: number; level: number; partial: string; onStop: () => void }
  if mode === 'recording'
    div(className='flex items-center gap-3 rounded-full border border-destructive/30 bg-destructive/10 py-1 pr-1 pl-3')
      span(className='relative flex size-2.5')
        span(className='absolute inline-flex size-full animate-ping rounded-full bg-destructive opacity-60')
        span(className='relative inline-flex size-2.5 rounded-full bg-destructive')
      span(className='font-mono text-[12px] numeral') #{clipTime(elapsed)}
      span(className='flex h-4 items-center gap-0.5' aria-hidden={true})
        each weight, index in LEVEL_BARS key index
          span(className='w-0.75 rounded-full bg-destructive transition-[height] duration-100' style={{ height: `${Math.max(3, level * weight * 16)}px` }})
      span(className='min-w-0 flex-1 truncate text-[13px] italic text-muted-foreground') #{partial || 'Recording and transcribing…'}
      button(type='button' onClick={onStop} className='inline-flex h-7 items-center gap-1.5 rounded-full bg-destructive px-3 text-[12px] font-medium text-white hover:brightness-110')
        Icon(name='stop' size={12} className='m-0')
        | Stop
  elseif mode === 'dictating'
    div(className='flex items-center gap-3 rounded-full border border-claim/40 bg-claim/10 py-1 pr-1 pl-3')
      Icon(name='mic' size={14} className='m-0 shrink-0 text-claim')
      span(className='min-w-0 flex-1 truncate text-[13px] italic text-muted-foreground') #{partial || 'Listening… speak and it types.'}
      button(type='button' onClick={onStop} className='inline-flex h-7 items-center rounded-full bg-claim px-3 text-[12px] font-medium text-claim-foreground hover:brightness-105') Done
  elseif mode === 'saving' || mode === 'starting'
    div(className='flex items-center gap-2 px-1 text-[13px] text-muted-foreground')
      Icon(name='spinner-ring' size={14} className='m-0')
      | #{mode === 'starting' ? 'Waiting for the microphone…' : 'Saving recording…'}

// The editing surface shared by the composer and the note dialog.
props { title, body, color, pinned, clips, onChange, onAppend, onAddClip, onRemoveClip, onDone, actions, startWith, autoFocus = 'body' }: NoteFieldsProps
setup
  const capture = useNoteCapture({ onDictated: onAppend, onClip: onAddClip })
  const [paletteOpen, setPaletteOpen] = useState(false)
  const done = () => {
    void capture.finish().then(onDone)
  }
  useEffect(() => {
    if (startWith === 'dictate') capture.toggleDictation()
    else if (startWith === 'record') capture.toggleRecording()
  }, [])

div(className='flex flex-col')
  div(className='flex items-start gap-2 px-4 pt-3')
    input(
      ~ value={title}
      ~ placeholder='Title'
      ~ aria-label='Title'
      ~ autoFocus={autoFocus === 'title'}
      ~ onInput={(event) => onChange({ title: event.currentTarget.value })}
      ~ className='min-w-0 flex-1 bg-transparent py-1 text-[16px] font-medium tracking-tight outline-none placeholder:text-muted-foreground'
      ~ )
    ToolButton(icon='pin' label={pinned ? 'Unpin note' : 'Pin note'} active={pinned} onClick={() => onChange({ pinned: !pinned })})
  textarea(
    ~ value={body}
    ~ placeholder='Take a note…'
    ~ aria-label='Note'
    ~ autoFocus={autoFocus === 'body'}
    ~ rows={3}
    ~ onInput={(event) => onChange({ body: event.currentTarget.value })}
    ~ className='field-sizing-content max-h-[50vh] min-h-20 resize-none bg-transparent px-4 py-2 text-[14.5px] leading-6 outline-none placeholder:text-muted-foreground'
    ~ )
  if clips.length > 0
    div(className='flex flex-col gap-2 px-4 pb-2')
      each clip in clips key clip.id
        ClipPlayer(clip={clip} onRemove={() => onRemoveClip(clip)})
  if capture.mode !== 'idle'
    div(className='px-3 pb-2')
      CaptureStatus(mode={capture.mode} elapsed={capture.elapsed} level={capture.level} partial={capture.partial} onStop={capture.mode === 'recording' ? capture.toggleRecording : capture.toggleDictation})
  if capture.error
    p(role='alert' className='px-4 pb-2 text-xs text-destructive-foreground') #{capture.error}
  if paletteOpen
    div(role='radiogroup' aria-label='Note colour' className='flex flex-wrap gap-1.5 px-4 pb-2')
      each key in NOTE_COLOR_KEYS key key
        button(
          ~ type='button'
          ~ role='radio'
          ~ aria-checked={color === key}
          ~ aria-label={NOTE_COLORS[key].label}
          ~ title={NOTE_COLORS[key].label}
          ~ onClick={() => onChange({ color: key as NoteColor })}
          ~ style={{ background: swatchBackground(key) }}
          ~ className={cn('grid size-7 place-items-center rounded-full border transition hover:scale-110', color === key ? 'border-foreground' : 'border-border')}
          ~ )
          if color === key
            Icon(name='check' size={13} className='m-0')
  div(className='flex items-center gap-0.5 px-2 pb-2')
    ToolButton(icon='mic' label={capture.canDictate ? (capture.mode === 'dictating' ? 'Stop dictation' : 'Dictate (speech to text)') : 'Dictation needs Chrome, Edge or Safari'} active={capture.mode === 'dictating'} tone='claim' disabled={!capture.canDictate || (capture.mode !== 'idle' && capture.mode !== 'dictating')} onClick={capture.toggleDictation})
    ToolButton(icon='audio-lines' label={capture.canRecord ? (capture.mode === 'recording' ? 'Stop recording' : 'Record audio') : 'Recording is not supported in this browser'} active={capture.mode === 'recording'} tone='danger' disabled={!capture.canRecord || capture.mode === 'saving' || capture.mode === 'starting'} onClick={capture.toggleRecording})
    ToolButton(icon='palette' label='Background colour' active={paletteOpen} onClick={() => setPaletteOpen(!paletteOpen)})
    | #{actions}
    button(type='button' data-note-close onClick={done} disabled={capture.mode === 'saving'} className='ml-auto h-8 rounded-full px-4 text-[13px] font-medium hover:bg-foreground/10 disabled:opacity-50') Close
