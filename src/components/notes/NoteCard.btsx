import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import { ToolButton } from './NoteFields.btsx'
import { noteBackground } from '@/lib/notes/colors'
import { clipTime } from '@/lib/notes/recorder'
import { deleteNote, updateNote } from '@/lib/notes/store'
import { timeAgo, useNow } from '@/lib/notes/time'
import { dateTime } from '@/lib/insurance/format'
import type { Note } from '@/lib/notes/types'

// A note on the board: title, clamped body, recordings summary; actions appear on hover.
props { note, onOpen }: { note: Note; onOpen: () => void }
setup const now = useNow()

article(
  ~ tabIndex={0}
  ~ aria-label={note.title || note.body.slice(0, 40) || 'Audio note'}
  ~ onClick={onOpen}
  ~ onKeyDown={(event) => { if (event.key === 'Enter') onOpen() }}
  ~ style={{ background: noteBackground(note.color) }}
  ~ className='group/note relative mb-3 cursor-pointer break-inside-avoid rounded-2xl border border-border bg-card px-4 pt-3 pb-2 outline-none transition-shadow hover:shadow-[0_2px_10px_-2px_oklch(0_0_0/35%)] focus-visible:ring-2 focus-visible:ring-ring'
  ~ )
  div(className={cn('absolute top-1.5 right-1.5 transition-opacity', note.pinned ? 'opacity-100' : 'opacity-0 group-hover/note:opacity-100 group-focus-within/note:opacity-100')} onClick={(event) => event.stopPropagation()})
    ToolButton(icon='pin' label={note.pinned ? 'Unpin note' : 'Pin note'} active={note.pinned} onClick={() => updateNote(note.id, { pinned: !note.pinned })})
  if note.title
    h3(className='pr-8 text-[15px] font-medium leading-6 tracking-tight') #{note.title}
  if note.body
    p(className={cn('line-clamp-[12] whitespace-pre-wrap break-words text-[14px] leading-6 text-foreground/85', !note.title && 'pr-8')}) #{note.body}
  if note.clips.length > 0
    ul(className='mt-2 flex flex-col gap-1.5')
      each clip in note.clips key clip.id
        li(className='flex items-center gap-2 rounded-lg bg-foreground/[0.06] px-2.5 py-1.5 text-[12.5px]')
          Icon(name='audio-lines' size={13} className='m-0 shrink-0 text-muted-foreground')
          span(className='font-mono numeral text-muted-foreground') #{clipTime(clip.duration)}
          span(className='min-w-0 flex-1 truncate text-foreground/75') #{clip.transcript || 'Voice recording'}
  if !note.title && !note.body && note.clips.length === 0
    p(className='text-sm text-muted-foreground') Empty note
  div(className='-mx-2 mt-1 flex items-center gap-0.5')
    div(className='flex items-center gap-0.5 opacity-0 transition-opacity group-hover/note:opacity-100 group-focus-within/note:opacity-100' onClick={(event) => event.stopPropagation()})
      ToolButton(icon='archive' label={note.archived ? 'Unarchive' : 'Archive'} onClick={() => updateNote(note.id, { archived: !note.archived, pinned: false })})
      ToolButton(icon='trash' label='Delete note' onClick={() => deleteNote(note.id)})
    time(dateTime={note.updatedDate} title={`Edited ${dateTime(note.updatedDate)}`} className='ml-auto pr-2 font-mono text-[10.5px] text-muted-foreground/60 transition-colors group-hover/note:text-foreground group-focus-within/note:text-foreground') #{timeAgo(note.updatedDate, now)}
