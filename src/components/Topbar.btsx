import { Link, useNavigate } from '@octanejs/tanstack-router'
import { Icon } from '@/lib/icons'
import { cn } from '@/lib/utils'
import { ThemeToggle } from './ThemeProvider.btsx'
import CtaButton from './kit/CtaButton.btsx'
import { toggleDock, useDock } from '@/lib/assistant/dock'
import { setTopbarSlot } from '@/lib/topbar-slot'

module
  interface TopbarProps {
    toggleSidebar: VoidFunction
    isCompact?: boolean
  }

  export { AssistantButton, Wordmark }

component Wordmark
  props { compact = false }: { compact?: boolean }
  Link(to='/' aria-label='SAIA home' className='flex items-center gap-2.5')
    if !compact
      span(className='flex flex-col leading-none')
        span(className='text-[15px] font-medium tracking-tight') SAI✦
        span(className='eyebrow text-[9.5px]') Agent

component AssistantButton
  setup const { open } = useDock()
  button(
    ~ type='button'
    ~ onClick={toggleDock}
    ~ aria-pressed={open}
    ~ aria-label='Open assistant'
    ~ title='Assistant (Ctrl+K)'
    ~ className={cn('inline-flex h-8 sm:h-10 lg:h-10 items-center gap-2 rounded-full border px-3 text-[13px] transition-colors bg-card text-muted-foreground', open ? 'border-border/80' : 'border-border hover:text-foreground')}
    ~ )
    Icon(name='mic-bold' size={15} className='m-0')
    span(className='hidden lg:inline') Assistant
    // kbd(className='hidden rounded border border-border bg-surface px-1 tracking-widest text-xs lg:inline') ⌘ K

props { toggleSidebar, isCompact = false }: TopbarProps
setup const navigate = useNavigate()

header(className='sticky top-0 z-40 w-full bg-background/80 backdrop-blur-xl')
  div(className='topbar flex w-full items-center justify-between gap-4 px-5')
    div(className='flex min-w-0 flex-1 items-center gap-4')
      Wordmark
      button(className='grid size-7 shrink-0 place-items-center rounded-md text-muted-foreground transition hover:bg-card hover:text-foreground' onClick={toggleSidebar} aria-label={isCompact ? 'Expand sidebar' : 'Compact sidebar'} aria-pressed={isCompact} title={isCompact ? 'Expand sidebar' : 'Compact sidebar'})
        Icon(name='sidebar' className='m-0 size-4')
      div(ref={setTopbarSlot} className='flex min-w-0 flex-1 items-center gap-4 empty:hidden')
    div(className='flex shrink-0 items-center gap-2')
      AssistantButton
      ThemeToggle
      CtaButton(label='New quote' icon='plus' variant='accent' onClick={() => navigate({ to: '/quote' })})
