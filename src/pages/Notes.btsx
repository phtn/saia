import { createElement, useState } from 'octane'
import { cn } from '@/lib/utils'
import { Icon } from '@/lib/icons'
import PageHeader from '@/components/PageHeader.btsx'
import NoteComposer from '@/components/notes/NoteComposer.btsx'
import NoteCard from '@/components/notes/NoteCard.btsx'
import NoteDialog from '@/components/notes/NoteDialog.btsx'
import { useNotes } from '@/lib/notes/store'
import type { Note } from '@/lib/notes/types'

module
  const matches = (note: Note, query: string) =>
    [note.title, note.body, ...note.clips.map((clip) => clip.transcript)].join(' ').toLowerCase().includes(query)

component NotesActions
  props { query, onQuery, archived, onArchived, archivedCount }: { query: string; onQuery: (value: string) => void; archived: boolean; onArchived: (value: boolean) => void; archivedCount: number }
  label(className='relative flex h-8 w-44 items-center lg:w-60')
    span(className='pointer-events-none absolute left-3 flex text-muted-foreground')
      Icon(name='search' size={14} className='m-0')
    input(type='search' value={query} placeholder='Search notes' aria-label='Search notes' onInput={(event) => onQuery(event.currentTarget.value)} className='h-8 w-full rounded-full border border-border bg-card pr-3 pl-8 text-[13px] outline-none placeholder:text-muted-foreground focus:border-ring')
  button(
    ~ type='button'
    ~ onClick={() => onArchived(!archived)}
    ~ aria-pressed={archived}
    ~ className={cn('inline-flex h-8 items-center gap-1.5 rounded-full border px-3 text-[13px] transition-colors', archived ? 'border-foreground/30 bg-foreground/10 text-foreground' : 'border-border bg-card text-muted-foreground hover:text-foreground')}
    ~ )
    Icon(name='archive' size={14} className='m-0')
    | #{archived ? 'Back to notes' : `Archive${archivedCount ? ` · ${archivedCount}` : ''}`}

component NoteColumns
  props { notes, onOpen }: { notes: Note[]; onOpen: (id: string) => void }
  div(className='columns-1 gap-3 sm:columns-2 lg:columns-3 2xl:columns-4')
    each note in notes key note.id
      NoteCard(note={note} onOpen={() => onOpen(note.id)})

props {}: {}
setup
  const notes = useNotes()
  const [query, setQuery] = useState('')
  const [archived, setArchived] = useState(false)
  const [openId, setOpenId] = useState<string | null>(null)
  const needle = query.trim().toLowerCase()
  const visible = notes.filter((note) => note.archived === archived && (needle === '' || matches(note, needle))).sort((a, b) => b.updatedDate.localeCompare(a.updatedDate))
  const pinned = visible.filter((note) => note.pinned)
  const others = visible.filter((note) => !note.pinned)
  const openNote = notes.find((note) => note.id === openId) ?? null
  const actions = createElement(NotesActions, { query, onQuery: setQuery, archived, onArchived: setArchived, archivedCount: notes.filter((note) => note.archived).length })

div(className='mx-auto w-full max-w-[1400px] px-4 py-6 md:px-8 md:py-8')
  PageHeader(title={archived ? 'Archive' : 'Notes'} description='Type, dictate or record. Recordings are transcribed as you speak and kept on this device.' actions={actions})
  if !archived
    div(className='mb-8')
      NoteComposer
  if visible.length === 0
    div(className='flex flex-col items-center gap-3 py-20 text-center text-muted-foreground')
      Icon(name={archived ? 'archive' : 'note'} size={40} className='m-0 opacity-40')
      p(className='text-[15px]') #{needle ? 'No notes match your search.' : archived ? 'Archived notes appear here.' : 'Notes you add appear here.'}
  elseif pinned.length > 0
    div
      p(className='eyebrow mb-2 px-1') Pinned
      NoteColumns(notes={pinned} onOpen={setOpenId})
      if others.length > 0
        div
          p(className='eyebrow mt-6 mb-2 px-1') Others
          NoteColumns(notes={others} onOpen={setOpenId})
  else
    NoteColumns(notes={others} onOpen={setOpenId})
  NoteDialog(note={openNote} onClose={() => setOpenId(null)})
