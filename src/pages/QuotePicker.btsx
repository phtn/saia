import { useNavigate } from '@octanejs/tanstack-router'
import PageHeader from '@/components/PageHeader.btsx'
import Shell from '@/components/kit/Shell.btsx'
import ProductGrid from '@/components/insurance/ProductGrid.btsx'
import QuoteRow from '@/components/insurance/QuoteRow.btsx'
import { useStore } from '@/lib/insurance/store'

setup
  const { quotes } = useStore()
  const navigate = useNavigate()
  const recent = quotes.filter((quote) => quote.status === 'Quote').sort((a, b) => b.updatedDate.localeCompare(a.updatedDate)).slice(0, 6)

div(className='mx-auto w-full max-w-[1400px] px-4 py-6 md:px-8 md:py-8')
  PageHeader(eyebrow='Quote' title='What are we insuring?' description='Pick a line of business. Every quote walks the same steps: client, risk, policy, create.')
  div(className='grid grid-cols-1 items-start gap-4 xl:grid-cols-[minmax(0,1fr)_380px]')
    Shell(title='Products' icon='sparkles')
      div(className='panel p-2')
        ProductGrid(quotes={quotes} detailed)
    Shell(title='Open quotes' icon='file-text')
      div(className='panel px-4 py-1')
        each quote in recent key quote.id
          QuoteRow(quote={quote} onClick={() => navigate({ to: '/policies' })})
        empty
          p(className='py-6 text-center text-sm text-muted-foreground') No open quotes yet.
