import { createElement, useState } from 'octane'
import { useNavigate } from '@octanejs/tanstack-router'
import { Icon } from '@/lib/icons'
import Shell from '@/components/kit/Shell.btsx'
import Panel from '@/components/kit/Panel.btsx'
import StatTile from '@/components/kit/StatTile.btsx'
import RingGauge from '@/components/kit/RingGauge.btsx'
import Chip from '@/components/kit/Chip.btsx'
import Segmented from '@/components/kit/Segmented.btsx'
import SegmentBar from '@/components/kit/SegmentBar.btsx'
import CtaButton from '@/components/kit/CtaButton.btsx'
import QuoteRow from '@/components/insurance/QuoteRow.btsx'
import ClaimRow from '@/components/insurance/ClaimRow.btsx'
import ProductGrid from '@/components/insurance/ProductGrid.btsx'
import { useStore, toggleReminder } from '@/lib/insurance/store'
import { bookKpis, renewalsDue } from '@/lib/insurance/analytics'
import { dateTime, percent, peso, pesoCompact } from '@/lib/insurance/format'
import { POLICY_STATUS, TONE_CLASSES, type Tone } from '@/lib/insurance/status'
import { downloadText, quotesToCsv } from '@/lib/insurance/export'
import type { PolicyStatus } from '@/lib/insurance/types'

module
  type Tab = 'pipeline' | 'renewals' | 'claims'

  const TONE_COLORS: Record<Tone, string> = {
    neutral: 'var(--neutral-dot)', warning: 'var(--warning)', info: 'var(--info)', success: 'var(--success)', danger: 'var(--destructive)', accent: 'var(--accent-brand)'
  }

  const PIPELINE: PolicyStatus[] = ['Quote', 'Pending', 'Verified', 'Active']

  const greeting = (date: Date) => (date.getHours() < 12 ? 'Good morning' : date.getHours() < 18 ? 'Good afternoon' : 'Good evening')

component OverviewFooter
  props { count, onExport }: { count: number; onExport: () => void }
  div(className='flex items-center gap-3')
    Icon(name='dashboard' size={14} className='m-0 text-muted-foreground')
    span(className='h-4 w-px bg-border')
    span(className='mono-caps text-[10.5px] text-muted-foreground') #{`Updated just now · ${count} records`}
  CtaButton(label='Export CSV' icon='upload' size='sm' onClick={onExport})

component LinkCaption
  props { label, onClick }: { label: string; onClick?: () => void }
  if onClick
    button(type='button' onClick={onClick} className='eyebrow hover:text-foreground') #{label}
  else
    span(className='eyebrow') #{label}

setup
  const { quotes, claims, reminders } = useStore()
  const navigate = useNavigate()
  const [tab, setTab] = useState<Tab>('pipeline')
  const now = new Date()
  const kpis = bookKpis(quotes, claims)
  const pipeline = quotes.filter((quote) => quote.status === 'Quote' || quote.status === 'Pending').sort((a, b) => b.updatedDate.localeCompare(a.updatedDate))
  const renewals = renewalsDue(quotes, 60)
  const openClaims = claims.filter((claim) => claim.status !== 'Paid' && claim.status !== 'Denied')
  const statusCounts = PIPELINE.map((status) => ({ status, count: quotes.filter((quote) => quote.status === status).length }))
  const today = reminders.filter((item) => !item.done).sort((a, b) => a.dueDatetime.localeCompare(b.dueDatetime)).slice(0, 4)
  const weekAgo = new Date(now.getTime() - 7 * 864e5).toISOString()
  const newThisWeek = quotes.filter((quote) => quote.createdDate >= weekAgo).length
  const tabs = [
    { value: 'pipeline', label: 'Pipeline', count: pipeline.length },
    { value: 'renewals', label: 'Renewals', count: renewals.length },
    { value: 'claims', label: 'Claims', count: openClaims.length }
  ]
  const exportCsv = () => downloadText(`saia-book-${now.toISOString().slice(0, 10)}.csv`, quotesToCsv(quotes))
  const openPolicies = () => navigate({ to: '/policies' })
  const footer = createElement(OverviewFooter, { count: quotes.length, onExport: exportCsv })
  const scopeChip = createElement(Chip, { label: 'All products', tone: 'neutral' })
  const quoteCount = createElement(LinkCaption, { label: `${quotes.length} quotes` })
  const allTasks = createElement(LinkCaption, { label: 'All tasks', onClick: () => navigate({ to: '/tasks' }) })

div(className='mx-auto w-full max-w-[1400px] px-4 py-6')
  header(className='flex flex-wrap items-end justify-between gap-4 pb-6')
    div
      p(className='eyebrow mb-2') #{now.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric' })}
      h1(className='text-2xl font-medium tracking-tight md:text-[28px]') #{greeting(now)}
      p(className='mt-1 text-sm text-muted-foreground') #{`${pipeline.length} quotes in play, ${renewals.length} renewals coming up, ${openClaims.length} open claims.`}
  div(className='grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_380px]')
    Shell(title='Book overview' icon='info' actions={scopeChip} footer={footer})
      div(className='panel p-5')
        div(className='flex flex-wrap items-start gap-5')
          RingGauge(value={kpis.conversion ?? 0} label={percent(kpis.conversion).replace('.0%', '%')})
          div(className='min-w-0 flex-1')
            p(className='eyebrow') Written premium
            div(className='mt-1.5 flex flex-wrap items-baseline gap-x-2 gap-y-1')
              span(className='numeral text-[36px] font-medium leading-none md:text-[48px]') #{pesoCompact(kpis.writtenPremium)}
              span(className='text-sm text-muted-foreground') #{`/ ${kpis.policies} policies`}
            div(className='mt-3 flex flex-wrap items-center gap-2')
              Chip(label={`+${newThisWeek}`} tone='success')
              span(className='mono-caps text-[10.5px] text-muted-foreground') New quotes this week · conversion
          CtaButton(label='New' icon='plus' variant='accent' className='hidden sm:inline-flex' onClick={() => navigate({ to: '/quote' })})
        div(className='mt-5 grid grid-cols-2 gap-1.5 lg:grid-cols-4')
          StatTile(label='Quotes' value={kpis.quotes} caption={`${pipeline.length} open`} captionTone='info')
          StatTile(label='In force' value={kpis.inForce} caption='Verified · active')
          StatTile(label='Pending' value={pesoCompact(kpis.pendingPremium)} caption={`${quotes.filter((quote) => quote.status === 'Pending').length} awaiting issue`} captionTone='warning')
          StatTile(label='Loss ratio' value={percent(kpis.lossRatio)} caption={`${kpis.claimsOpen} open claims`} captionTone={kpis.claimsOpen > 0 ? 'danger' : 'neutral'})
      div(className='panel p-2')
        Segmented(label='Book view' options={tabs} value={tab} onChange={(value) => setTab(value === 'renewals' ? 'renewals' : value === 'claims' ? 'claims' : 'pipeline')})
      switch tab
        case 'pipeline'
          Panel(title='Pipeline' count={pipeline.length} caption='Latest first')
            SegmentBar(segments={statusCounts.map((item) => ({ key: item.status, value: item.count, color: TONE_COLORS[POLICY_STATUS[item.status].tone] }))})
            div(className='mt-3 mb-2 flex flex-wrap gap-1.5')
              each item in statusCounts key item.status
                span(className='inline-flex items-center gap-1.5 rounded-full bg-surface px-2.5 py-1 text-[13px]')
                  span(className={`size-2 rounded-full ${TONE_CLASSES[POLICY_STATUS[item.status].tone].dot}`})
                  | #{item.status}
                  span(className='font-mono text-[11px] text-muted-foreground numeral') #{item.count}
            each quote in pipeline.slice(0, 5) key quote.id
              QuoteRow(quote={quote} onClick={openPolicies})
            empty
              p(className='py-6 text-center text-sm text-muted-foreground') No open quotes. Start one from Quick quote.
            if pipeline.length > 5
              button(type='button' onClick={openPolicies} className='mono-caps mt-2 flex items-center gap-2 text-[10.5px] text-muted-foreground hover:text-foreground')
                span(className='grid size-6 place-items-center rounded-full border border-border')
                  Icon(name='plus' size={12} className='m-0')
                | #{`Show all ${pipeline.length}`}
        case 'renewals'
          Panel(title='Renewals' count={renewals.length} caption='Next 60 days')
            each quote in renewals key quote.id
              QuoteRow(quote={quote} renewal onClick={openPolicies})
            empty
              p(className='py-6 text-center text-sm text-muted-foreground') Nothing expires in the next 60 days.
        case 'claims'
          Panel(title='Open claims' count={openClaims.length} caption='By incident date')
            each claim in openClaims key claim.id
              ClaimRow(claim={claim} onClick={() => navigate({ to: '/claims' })})
            empty
              p(className='py-6 text-center text-sm text-muted-foreground') No open claims.
    div(className='flex flex-col gap-4')

      Shell(title='Quick quote' icon='sparkles' actions={quoteCount} className='bg-sidebar-border/80! border border-border dark:border-lines/60 infinite-lines shadow-xs')
        div(className=' p-2')
          ProductGrid(quotes={quotes})
      Shell(title='Today' icon='calendar' actions={allTasks})
        div(className='panel px-4 py-1')
          each item in today key item.id
            div(className='flex items-start gap-3 border-b border-border py-3 last:border-b-0')
              button(type='button' onClick={() => toggleReminder(item.id)} aria-label={`Mark ${item.title} done`} className='mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-border text-transparent transition-colors hover:border-success hover:text-success')
                Icon(name='check' size={12} className='m-0')
              div(className='min-w-0')
                p(className='text-sm leading-5') #{item.title}
                p(className='mono-caps mt-0.5 text-[10px] text-muted-foreground') #{dateTime(item.dueDatetime)}
          empty
            p(className='py-6 text-center text-sm text-muted-foreground') All caught up.
      Shell(title='Collected' icon='wallet')
        div(className='panel p-4')
          p(className='eyebrow') Claims paid
          p(className='numeral mt-1.5 text-[28px] font-medium leading-none') #{peso(kpis.claimsPaid)}
          p(className='mono-caps mt-2 text-[10.5px] text-muted-foreground') #{`${claims.length} claims on file`}
