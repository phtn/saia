{
  "name": "saia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run tac:index && rsbuild dev",
    "build": "bun run tac:index && rsbuild build",
    "preview": "bun run tac:index && rsbuild preview",
    "typecheck": "bun run tac:index && node scripts/typecheck-btsx.mjs && tsc -p worker/tsconfig.json",
    "check": "bun run typecheck && bun run build",
    "cf:types": "wrangler types worker/worker-configuration.d.ts --include-env=false",
    "cf:dev": "bun run build && wrangler dev",
    "cf:deploy": "bun run check && wrangler deploy",
    "tac:index": "node scripts/build-tac-index.mjs"
  },
  "dependencies": {
    "@octanejs/day-picker": "^0.0.22",
    "@octanejs/resizable-panels": "^0.0.13",
    "@octanejs/shadcn": "0.0.38",
    "@octanejs/tanstack-form": "^0.0.52",
    "@octanejs/tanstack-router": "^0.1.56",
    "beast-tsrx": "0.2.62",
    "clsx": "^2.1.1",
    "octane": "0.2.13",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@octanejs/rsbuild-plugin": "0.1.50",
    "@rsbuild/core": "^2.2.2",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@tsrx/typescript-plugin": "0.3.135",
    "@types/node": "^26.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.140.0"
  }
}
